{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": false,
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "vite.config.ts",
    "*.config.ts",
    "*.config.mts",
    "*.config.cts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
